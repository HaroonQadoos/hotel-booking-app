MONGODB_URI=mongodb://localhost:27017/hotel-booking
AUTH_SECRET=change-me

# Where the React app (hotel-booking-client) is served. Password-reset links
# point here, at its /reset-password page.
FRONTEND_URL=http://localhost:5173

# The address browsers reach this API at. Uploaded room and venue photos are
# saved under ./uploads and linked as <PUBLIC_API_URL>/uploads/<file>.
# Defaults to http://localhost:<PORT> when unset.
# PUBLIC_API_URL=https://api.example.com

# Outgoing mail. Leave MAIL_HOST unset to use a throwaway Ethereal inbox in
# dev (nothing is delivered — a preview URL is logged instead). Set it to send
# real mail; e.g. for Gmail use smtp.gmail.com / 587 with an App Password.
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USER=you@gmail.com
# MAIL_PASS=your-app-password
# MAIL_SECURE=false
# MAIL_FROM="Hotel Booking" <you@gmail.com>

# Used only by `npm run seed:admin` to create (or promote) the admin account.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me-too
# ADMIN_NAME=Admin
# Set to true to also overwrite an existing account's password with ADMIN_PASSWORD.
# ADMIN_RESET_PASSWORD=true
